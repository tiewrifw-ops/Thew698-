local gunHighlight = nil

RunService.Heartbeat:Connect(function()
    local gunDrop = workspace:FindFirstChild("GunDrop")
    
    if MM2_Settings.MasterESP and MM2_Settings.GunDropESP and gunDrop then
        if not gunHighlight or gunHighlight.Parent ~= gunDrop then
            if gunHighlight then gunHighlight:Destroy() end
            gunHighlight = Instance.new("Highlight")
            gunHighlight.Parent = gunDrop
            gunHighlight.FillColor = Color3.fromRGB(255, 215, 0)
            gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        end
        gunHighlight.Enabled = true
    else
        if gunHighlight then gunHighlight.Enabled = false end
    end

    if MM2_Settings.AutoFetchGun and gunDrop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = gunDrop.CFrame + Vector3.new(0, 2, 0)
    end
end)

------------------------------------------------------------------------
-- 3. AIMLOCK & AUTO SHOOT
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not MM2_Settings.AimLock then return end

    local myRole = MM2_GetRole(LocalPlayer)
    local target = nil

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local r = MM2_GetRole(p)
            if (myRole == "Sheriff" or myRole == "Innocent") and r == "Murderer" then
                target = p
                break
            elseif myRole == "Murderer" then
                if r == "Sheriff" then target = p break
                elseif not target then target = p end
            end
        end
    end

    if target and target.Character and target.Character:FindFirstChild("Head") then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        if MM2_Settings.AutoShoot and (myRole == "Sheriff" or (myRole == "Innocent" and LocalPlayer.Character:FindFirstChild("Gun"))) then
            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool and tool.Name:lower():find("gun") then tool:Activate() end
        end
    end
end)

------------------------------------------------------------------------
-- 4. UTILITIES & 3-WAY AUTO-KILL
------------------------------------------------------------------------
RunService.Stepped:Connect(function()
    if MM2_Settings.Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        hum.WalkSpeed = MM2_Settings.WalkSpeed
        hum.UseJumpPower = true
        hum.JumpPower = MM2_Settings.JumpPower
    end
end)

RunService.Heartbeat:Connect(function()
    if not MM2_Settings.AutoKill or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end

    local myRole = MM2_GetRole(LocalPlayer)
    local myHRP = LocalPlayer.Character.HumanoidRootPart

    if myRole == "Murderer" then
        local target = nil
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                if MM2_GetRole(p) == "Sheriff" then target = p break
                elseif not target then target = p end
            end
        end

        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 1.2)
            local knife = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
            if knife then knife.Parent = LocalPlayer.Character knife:Activate() end
        end

    elseif myRole == "Sheriff" or (myRole == "Innocent" and LocalPlayer.Character:FindFirstChild("Gun")) then
        local murderer = nil
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and MM2_GetRole(p) == "Murderer" and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                murderer = p
                break
            end
        end

        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
            myHRP.CFrame = murderer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, murderer.Character.HumanoidRootPart.Position)
            local gun = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
            if gun then gun.Parent = LocalPlayer.Character gun:Activate() end
        end
    end
end)
