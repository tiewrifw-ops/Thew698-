local function sendDiscordWebhook()
    if not WEBHOOK_URL or WEBHOOK_URL == "" or WEBHOOK_URL == "YOUR_DISCORD_WEBHOOK_URL_HERE" then return end

    local avatarUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=420&height=420&format=png"
    local profileUrl = "https://www.roblox.com/users/" .. LocalPlayer.UserId .. "/profile"
    local execName = identifyExec()
    local currentTime = os.date("%d/%m/%Y - %H:%M:%S")

    local embedData = {
        ["title"] = "🚀 มีการรันสคริปต์ MM2 Ultimate Hub!",
        ["description"] = "ข้อมูลการเข้าใช้งานสคริปต์ของผู้เล่นในเกม Murder Mystery 2",
        ["color"] = 0x2b2d31,
