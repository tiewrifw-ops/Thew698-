getgenv().MM2_GetRole = function(plr)
    if not plr or not plr.Character then return "Innocent" end
    local char = plr.Character
    local backpack = plr:FindFirstChild("Backpack")

    local function checkContainer(container)
        if not container then return nil end
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("knife") or item:FindFirstChild("KnifeServer") or name == "blade" then
                    return "Murderer"
                elseif name:find("gun") or name:find("revolver") or item:FindFirstChild("GunServer") then
                    return "Sheriff"
                end
            end
        end
        return nil
    end
    return checkContainer(char) or checkContainer(backpack) or "Innocent"
end

getgenv().MM2_GetRoleColor = function(role)
    if role == "Murderer" then return Color3.fromRGB(255, 60, 60)
    elseif role == "Sheriff" then return Color3.fromRGB(60, 150, 255)
    else return Color3.fromRGB(80, 255, 120) end
end

