-- ESP Engine, Combat Loops & AutoKill

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local espBoxes = {}
local espHighlights = {}
local espBillboards = {}

local function removePlayerESP(p)
    if espBoxes[p] then pcall(function() espBoxes[p]:Remove() end) espBoxes[p] = nil end
    if espHighlights[p] then pcall(function() espHighlights[p]:Destroy() end) espHighlights[p] = nil end
    if espBillboards[p] then pcall(function() espBillboards[p]:Destroy() end) espBillboards[p] = nil end
end

------------------------------------------------------------------------
-- 1. ESP MAIN ENGINE
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not MM2_Settings or not MM2_Settings.MasterESP then
        for p, _ in pairs(espBoxes) do removePlayerESP(p) end
        return
    end

    for _, target in pairs(Players:GetPlayers()) do
        if target ~= LocalPlayer then
            local char = target.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local hrp = char.HumanoidRootPart
                local role = MM2_GetRole(target)
                local color = MM2_GetRoleColor(role)
                local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                -- Box ESP
                if MM2_Settings.BoxESP and onScreen then
                    if not espBoxes[target] then
                        local box = Drawing.new("Square")
                        box.Thickness = 2
                        box.Filled = false
                        box.Transparency = 1
                        espBoxes[target] = box
                    end
                    local head = char:FindFirstChild("Head")
                    local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or hrpPos
                    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 1.5

                    local box = espBoxes[target]
                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2)
                    box.Color = color
                    box.Visible = true
                else
                    if espBoxes[target] then espBoxes[target].Visible = false end
                end

                -- Highlight X-Ray
                if MM2_Settings.HighlightESP then
                    if not espHighlights[target] or espHighlights[target].Parent ~= char then
                        if espHighlights[target] then espHighlights[target]:Destroy() end
                        local hl = Instance.new("Highlight")
                        hl.Parent = char
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        espHighlights[target] = hl
                    end
                    espHighlights[target].FillColor = color
                    espHighlights[target].OutlineColor = color
                    espHighlights[target].Enabled = true
                else
                    if espHighlights[target] then espHighlights[target].Enabled = false end
                end

                -- Name & Role Info
                if (MM2_Settings.NameESP or MM2_Settings.RoleESP) then
                    if not espBillboards[target] or espBillboards[target].Parent ~= char:FindFirstChild("Head") then
                        if espBillboards[target] then espBillboards[target]:Destroy() end
                        local head = char:FindFirstChild("Head")
                        if head then
                            local bb = Instance.new("BillboardGui")
                            bb.Parent = head
                            bb.Adornee = head
                            bb.Size = UDim2.new(0, 150, 0, 40)
                            bb.StudsOffset = Vector3.new(0, 2, 0)
                            bb.AlwaysOnTop = true

                            local lbl = Instance.new("TextLabel")
                            lbl.Name = "Info"
                            lbl.Parent = bb
                            lbl.Size = UDim2.new(1, 0, 1, 0)
                            lbl.BackgroundTransparency = 1
                            lbl.Font = Enum.Font.SourceSansBold
                            lbl.TextSize = 13
                            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                            lbl.TextStrokeTransparency = 0
                            espBillboards[target] = bb
                        end
                    end

                    if espBillboards[target] and espBillboards[target]:FindFirstChild("Info") then
                        local txt = ""
                        if MM2_Settings.NameESP then txt = txt .. target.DisplayName end
                        if MM2_Settings.RoleESP then txt = txt .. " [" .. role .. "]" end
                        espBillboards[target].Info.Text = txt
                        espBillboards[target].Info.TextColor3 = color
                        espBillboards[target].Enabled = true
                    end
                else
                    if espBillboards[target] then espBillboards[target].Enabled = false end
                end
            else
                removePlayerESP(target)
            end
        end
    end
end)

Players.PlayerRemoving:Connect(removePlayerESP)

