            { ["name"] = "👤 ผู้ใช้งาน", ["value"] = "[" .. LocalPlayer.Name .. " (" .. LocalPlayer.DisplayName .. ")](" .. profileUrl .. ")", ["inline"] = true },
            { ["name"] = "🆔 User ID", ["value"] = tostring(LocalPlayer.UserId), ["inline"] = true },
