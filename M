local function createToggle(nameKey, default, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = scroll
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.BackgroundColor3 = default and Color3.fromRGB(30, 70, 50) or Color3.fromRGB(30, 30, 40)
    btn.Text = "  " .. MM2_Dict[MM2_Settings.Language][nameKey] .. " : " .. (default and "ON" or "OFF")
    btn.TextColor3 = default and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(30, 70, 50) or Color3.fromRGB(30, 30, 40)
        btn.Text = "  " .. MM2_Dict[MM2_Settings.Language][nameKey] .. " : " .. (state and "ON" or "OFF")
        btn.TextColor3 = state and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(200, 200, 200)
        callback(state)
    end)
end

local function createSlider(nameKey, min, max, default, callback)
    local container = Instance.new("Frame")
    container.Parent = scroll
    container.Size = UDim2.new(1, -10, 0, 50)
    container.BackgroundColor3 = Color3.fromRGB(28, 28, 38)

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.Position = UDim2.new(0, 10, 0, 5)
    label.Size = UDim2.new(1, -20, 0, 20)
    label.Text = MM2_Dict[MM2_Settings.Language][nameKey] .. tostring(default)
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.BackgroundTransparency = 1

    local sliderBar = Instance.new("Frame")
    sliderBar.Parent = container
    sliderBar.Position = UDim2.new(0, 10, 0, 30)
    sliderBar.Size = UDim2.new(1, -20, 0, 8)
    sliderBar.BackgroundColor3 = Color3.fromRGB(45, 45, 60)

    local fill = Instance.new("Frame")
    fill.Parent = sliderBar
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + (max - min) * pos)
        label.Text = MM2_Dict[MM2_Settings.Language][nameKey] .. tostring(val)
        callback(val)
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

