-- 4. ระบบ ESP 2D Box สีดำ (Drawing API)
-- =================================================================
local ESP_Enabled = false
local ESP_Boxes = {}

local function CreateESPBox(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Square")
    box.Color = Color3.fromRGB(0, 0, 0)
    box.Thickness = 2
    box.Filled = false
    box.Transparency = 1
    box.Visible = false
    
    ESP_Boxes[player] = box
end

local function RemoveESPBox(player)
    if ESP_Boxes[player] then
        ESP_Boxes[player]:Remove()
        ESP_Boxes[player] = nil
    end
end

for _, player in ipairs(Services.Players:GetPlayers()) do
    CreateESPBox(player)
end

Services.Players.PlayerAdded:Connect(CreateESPBox)
Services.Players.PlayerRemoving:Connect(RemoveESPBox)

Services.RunService.RenderStepped:Connect(function()
    for player, box in pairs(ESP_Boxes) do
        if ESP_Enabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local head = player.Character:FindFirstChild("Head")
                local headPos = head and head.Position or (hrp.Position + Vector3.new(0, 3, 0))
                local legsPos = hrp.Position - Vector3.new(0, 3, 0)
                
                local headScreen = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.5, 0))
                local legsScreen = Camera:WorldToViewportPoint(legsPos)
                
                local height = math.abs(headScreen.Y - legsScreen.Y)
                local width = height * 0.65
                
                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(pos.X - (width / 2), pos.Y - (height / 2))
                box.Visible = true
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    end
end)

