-- 7. ระบบ Teleport ไปหาผู้เล่นอื่น
-- =================================================================
local TargetPlayerName = ""

local function TeleportToPlayer(targetName)
    if targetName == "" then return end
    
    targetName = targetName:lower()
    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local nameMatch = player.Name:lower():sub(1, #targetName) == targetName
            local displayMatch = player.DisplayName:lower():sub(1, #targetName) == targetName
            
            if nameMatch or displayMatch then
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                    return true
                end
            end
        end
    end
    return false
end

