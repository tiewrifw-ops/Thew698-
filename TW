local function applyHighlight(plr)
    if plr == LocalPlayer then return end
    local function setupChar(char)
        if not char then return end
        local hl = char:FindFirstChild("DeltaXHighlight")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "DeltaXHighlight"
            hl.FillTransparency = 0.4
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- มองทะลุกำแพง
            hl.Parent = char
        end
        hl.Enabled = espChamsEnabled
    end

    if plr.Character then setupChar(plr.Character) end
    plr.CharacterAdded:Connect(setupChar)
end

for _, p in pairs(Players:GetPlayers()) do applyHighlight(p) end
Players.PlayerAdded:Connect(applyHighlight)

